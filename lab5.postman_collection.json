{
  "info": {
    "name": "Кешуючий проксі: ЛР5",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "origSize",
      "value": ""
    },
    {
      "key": "tMiss",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. GET /404: немає в кеші (промах)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type: image/jpeg', () => pm.expect(pm.response.headers.get('Content-Type')).to.eql('image/jpeg'));",
              "pm.test('X-Cache: MISS (взято з http.cat)', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('MISS'));",
              "pm.collectionVariables.set('origSize', pm.response.size().body);",
              "pm.collectionVariables.set('tMiss', pm.response.responseTime);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/404",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "404"
          ]
        }
      }
    },
    {
      "name": "2. GET /404 вдруге: з кешу (влучання)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type: image/jpeg', () => pm.expect(pm.response.headers.get('Content-Type')).to.eql('image/jpeg'));",
              "pm.test('X-Cache: HIT (взято з кешу)', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('HIT'));",
              "pm.test('Та сама картинка (розмір збігається)', () => pm.expect(pm.response.size().body).to.eql(Number(pm.collectionVariables.get('origSize'))));",
              "console.log('Час: промах ' + pm.collectionVariables.get('tMiss') + ' мс, влучання ' + pm.response.responseTime + ' мс');"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/404",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "404"
          ]
        }
      }
    },
    {
      "name": "3. PUT /404: власна картинка",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "image/jpeg"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/404",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "404"
          ]
        },
        "body": {
          "mode": "file",
          "file": {
            "src": "my.jpg"
          }
        }
      }
    },
    {
      "name": "4. GET /404 після PUT: моя картинка, а не з http.cat",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 200', () => pm.response.to.have.status(200));",
              "pm.test('X-Cache: HIT', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('HIT'));",
              "pm.test('Картинка інша, ніж була з http.cat', () => pm.expect(pm.response.size().body).to.not.eql(Number(pm.collectionVariables.get('origSize'))));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/404",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "404"
          ]
        }
      }
    },
    {
      "name": "5. DELETE /404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/404",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "404"
          ]
        }
      }
    },
    {
      "name": "6. DELETE /404: вже немає в кеші",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/404",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "404"
          ]
        }
      }
    },
    {
      "name": "7. GET /999: неіснуючий код",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 404', () => pm.response.to.have.status(404));",
              "pm.test('Немає заголовка X-Cache', () => pm.expect(pm.response.headers.has('X-Cache')).to.be.false);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "999"
          ]
        }
      }
    },
    {
      "name": "8. POST /404: недозволений метод",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 405', () => pm.response.to.have.status(405));",
              "pm.test('Allow містить GET, PUT, DELETE', () => pm.expect(pm.response.headers.get('Allow')).to.eql('GET, PUT, DELETE'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/404",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "404"
          ]
        }
      }
    }
  ]
}